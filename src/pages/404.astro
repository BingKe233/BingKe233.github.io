---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在" description="404">
	<div class="not-found">
		<p class="error-code">404</p>
		<h1>这个页面不存在</h1>
		<p>链接可能失效了，或者文章还没写。</p>
		<p>
			<a class="button" href="/">回首页 <span aria-hidden="true">→</span></a>
		</p>
	</div>
</BaseLayout>
