---
import { getCollection } from 'astro:content';
import PostCard from '../components/PostCard.astro';
import SitePortrait from '../components/SitePortrait.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
	HERO_BIO,
	HERO_CTA,
	HERO_EYEBROW,
	HERO_LINE_1,
	HERO_LINE_2,
	HERO_TOPICS,
	SOCIAL_LINKS,
} from '../consts';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 4);

const total = (await getCollection('blog', ({ data }) => !data.draft)).length;
---

<BaseLayout>
	<section class="hero" aria-labelledby="home-title">
		<div class="hero-copy">
			<p class="eyebrow">{HERO_EYEBROW}</p>
			<h1 id="home-title">
				{HERO_LINE_1}<br /><span>{HERO_LINE_2}</span>
			</h1>
			<p class="hero-bio">{HERO_BIO}</p>
			<div class="hero-links">
				<a class="button" href={HERO_CTA.href}>
					{HERO_CTA.label} <span aria-hidden="true">→</span>
				</a>
				{
					SOCIAL_LINKS.map((link) => (
						<a
							href={link.href}
							target={link.external ? '_blank' : undefined}
							rel={link.external ? 'noopener noreferrer' : undefined}
						>
							{link.label}
							{link.external && ' ↗'}
						</a>
					))
				}
			</div>
		</div>
		<SitePortrait />
	</section>

	<div class="topic-strip">
		{HERO_TOPICS.map((topic) => <span>{topic}</span>)}
		<span class="strip-caption">SINCE 2026 · {total} POSTS</span>
	</div>

	<section class="home-section" aria-labelledby="latest-title">
		<div class="section-heading">
			<div>
				<span class="eyebrow">ARTICLES</span>
				<h2 id="latest-title">最近写的</h2>
			</div>
			<a class="text-link" href="/blog/">全部文章 <span aria-hidden="true">→</span></a>
		</div>
		{posts.map((post) => <PostCard post={post} />)}
	</section>
</BaseLayout>
